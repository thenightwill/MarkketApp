{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Supermarket.Api",
    "Audience": "Supermarket.Web",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Enabled": false
  }
}
